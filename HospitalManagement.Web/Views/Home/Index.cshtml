@model HomeVM
@{ViewData["Title"]="Đặt lịch khám";}
<section class="hero"><div class="container hero-inner"><div><h1>Đặt lịch khám, biết trước giờ và số thứ tự.</h1><p>Chọn bác sĩ và một khung giờ còn trống. Không cần tài khoản.</p><div class="action-row"><a href="/Appointment/Book" class="btn btn-primary">Đặt lịch khám <ui-icon name="arrow-right"/></a><a href="/Home/Doctors" class="link-action">Tìm bác sĩ</a></div><p class="metadata">Hệ thống có @Model.DoctorCount bác sĩ và @Model.ServiceCount dịch vụ xét nghiệm.</p></div><ui-photo name="hero-atrium" hero="true" alt="Sảnh chờ bệnh viện có cửa sổ lam gỗ, nắng đổ thành vệt dài trên nền đá mài, quầy tiếp đón gỗ sáng màu."/></div></section>
<section class="container section"><h2>Đặt một lịch khám như thế nào?</h2><ol class="steps-strip"><li><strong>1</strong><span>Chọn bác sĩ theo chuyên khoa.</span></li><li><strong>2</strong><span>Chọn ngày và giờ còn trống.</span></li><li><strong>3</strong><span>Điền thông tin người khám.</span></li><li><strong>4</strong><span>Lưu phiếu có mã và số thứ tự.</span></li></ol></section>
<section class="container section--compact"><div class="section-head"><div><h2>Xem lịch làm việc của bác sĩ</h2><p>Danh sách chuyên khoa, thông tin bác sĩ và lịch khám trong tuần.</p></div><a href="/Home/Doctors" class="link-action">Xem tất cả @Model.DoctorCount bác sĩ <ui-icon name="arrow-right"/></a></div></section>
<section class="container section"><div class="section-head"><div><h2>Gói khám sức khỏe</h2><p>So sánh các mục khám và phí trước khi đăng ký.</p></div><a href="/HealthPackage" class="link-action">Xem các gói khám</a></div><div class="package-columns">@foreach(var package in Model.Packages){<partial name="_PackageCard" model="package"/>}</div><p>Đăng ký đặt cọc chưa phải thanh toán. Nhân viên tiếp nhận ghi nhận tiền thực thu tại bệnh viện.</p></section>
<section class="container section--compact"><div class="intro-split"><div><h2>Tra cứu xét nghiệm</h2><p>Xem loại mẫu, thời gian thực hiện, giờ trả kết quả và phí dịch vụ trước khi đặt.</p><form action="/Diagnostic" method="get" class="quick-search"><div><label for="home-service" class="form-label">Tên dịch vụ xét nghiệm</label><input id="home-service" name="q" class="form-control" type="search"/></div><button class="btn btn-primary">Tìm dịch vụ</button></form></div><img class="plate" src="/img/plate/microscope.webp" width="200" height="200" alt="" aria-hidden="true" loading="lazy"/></div></section>
<section class="container section"><div class="section-head"><h2>Tin tức bệnh viện</h2><a href="/Home/News" class="link-action">Tất cả bài viết</a></div><div class="news-list">@foreach(var news in Model.News){<partial name="_NewsCard" model="news"/>}</div></section>
