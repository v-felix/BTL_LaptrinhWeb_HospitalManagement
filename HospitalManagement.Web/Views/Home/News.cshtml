@model List<News>
@{ViewData["Title"]="Tin tức bệnh viện";}
<div class="container"><header class="page-intro"><h1>Tin tức bệnh viện</h1><p>Thông tin và hoạt động được đăng trong hệ thống.</p></header><form method="get" class="filter-panel"><div><label for="q" class="form-label">Tìm bài viết</label><input id="q" name="q" value="@ViewBag.Q" type="search" class="form-control"/></div><button class="btn btn-primary">Tìm kiếm</button><a asp-action="News" class="link-action">Xóa lọc</a></form><div class="catalog-layout catalog-layout--news"><section><div class="news-list">@foreach(var news in Model){<partial name="_NewsCard" model="news"/>}</div></section><aside class="catalog-sidebar"><h2>Chuyên mục</h2><label for="news-category" class="form-label">Lọc trong bài viết đang hiển thị</label><select id="news-category" class="form-select" data-client-filter=".news-row" data-filter-attribute="category" data-filter-status="news-count"><option value="">Tất cả chuyên mục</option>@foreach(var category in Model.Select(x=>x.Category).Distinct().OrderBy(x=>x)){<option value="@category">@PresentationLabels.NewsCategory(category)</option>}</select><p id="news-count" role="status" aria-live="polite">@Model.Count bài viết.</p></aside></div>@if(Model.Count==0){<div class="empty"><img class="plate" src="/img/plate/leaf.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Chưa có bài viết phù hợp</h2><a asp-action="News" class="link-action">Xem tất cả bài viết</a></div>}</div>
