@model List<Doctor>
@{ViewData["Title"]="Bác sĩ";var all=string.IsNullOrEmpty((string?)ViewBag.Q)&&string.IsNullOrEmpty((string?)ViewBag.Speciality);}
<div class="container"><header class="page-intro intro-split"><div><h1>Bác sĩ</h1><p>@Model.Count bác sĩ thuộc @Model.Select(x=>x.Speciality).Distinct().Count() chuyên khoa@(all?".":" trong kết quả lọc.")</p><p>Xem lịch làm việc và phí khám trước khi chọn giờ.</p></div><ui-photo class="photo photo--room intro-photo" min-width="600" name="consult-room" alt="Phòng khám trống với bàn gỗ và hai chiếc ghế đối diện nhau cạnh cửa sổ."/></header>
<div class="catalog-layout"><aside class="catalog-sidebar"><h2>Chuyên khoa</h2><ul class="index-list desktop-index"><li><a asp-action="Doctors" aria-current="@(string.IsNullOrEmpty((string?)ViewBag.Speciality)?"page":null)">Tất cả</a></li>@foreach(string s in ViewBag.Specialities){<li><a asp-action="Doctors" asp-route-speciality="@s" aria-current="@(s==(string?)ViewBag.Speciality?"page":null)"><span>@s</span>@if(all){<span class="index-leader" aria-hidden="true"></span><span class="index-count">@Model.Count(x=>x.Speciality==s)</span>}</a></li>}</ul><form method="get" class="mobile-filter"><label for="speciality" class="form-label">Chọn chuyên khoa</label><select id="speciality" name="speciality" class="form-select"><option value="">Tất cả</option>@foreach(string s in ViewBag.Specialities){<option value="@s" selected="@(s==(string?)ViewBag.Speciality)">@s</option>}</select><button class="btn mt-3">Xem chuyên khoa</button></form></aside>
<section><form method="get" class="catalog-toolbar"><input type="hidden" name="speciality" value="@ViewBag.Speciality"/><label for="q" class="form-label">Tìm theo tên hoặc chuyên khoa</label><div class="quick-search"><input id="q" name="q" value="@ViewBag.Q" data-client-filter=".doctor-list .doctor-row" data-filter-status="doctor-count" class="form-control" type="search"/><button class="btn btn-primary">Tìm bác sĩ</button><a asp-action="Doctors" class="link-action">Xóa lọc</a></div></form><p id="doctor-count" role="status" aria-live="polite">Hiển thị @Model.Count bác sĩ.</p><div class="doctor-list">@foreach(var doctor in Model){<partial name="_DoctorCard" model="doctor"/>}</div>@if(Model.Count==0){<div class="empty"><img class="plate" src="/img/plate/watch.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Không tìm thấy bác sĩ phù hợp</h2><p>Thử tên ngắn hơn hoặc chọn tất cả chuyên khoa.</p><a asp-action="Doctors" class="btn">Bỏ bộ lọc</a></div>}</section></div></div>
