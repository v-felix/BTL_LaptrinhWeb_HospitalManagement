@model Doctor
@{ViewData["Title"]=Model.User.FullName;}
<div class="container section"><a href="/Home/Doctors" class="link-action"><ui-icon name="arrow-left"/>Danh sách bác sĩ</a><div class="split-form mt-4"><div><ui-monogram id="@Model.Id" name="@Model.User.FullName" photo="@Model.User.Photo" large="true"/><h1>@Model.User.FullName</h1><p>@Model.Designation</p><p>@Model.Speciality</p><p class="prose">@Model.About</p>@if(!string.IsNullOrWhiteSpace(Model.Phone)){<p>Điện thoại: @Model.Phone</p>}<a href="/Appointment/Book?doctorId=@Model.Id" class="btn btn-primary">Đặt lịch với bác sĩ</a></div><section><h2>Lịch khám trong tuần</h2><p>Mỗi ngày nhận tối đa số lượt đã công bố. Giờ còn trống được cập nhật khi đặt lịch.</p><div class="table-responsive"><table class="table ledger-responsive"><caption class="visually-hidden">Ca khám hàng tuần của @Model.User.FullName</caption><thead><tr><th scope="col">Ngày</th><th scope="col">Ca khám</th><th scope="col">Mỗi lượt / tối đa</th><th scope="col" class="money">Phí khám</th></tr></thead><tbody>@foreach(var day in new[]{1,2,3,4,5,6,0}){var s=Model.Schedules.FirstOrDefault(x=>x.DayOfWeek==day);<tr><th scope="row">@Display.Day(day)</th><td data-label="Ca khám">@(s==null?"Nghỉ":s.StartTime.ToString("HH:mm")+" – "+s.EndTime.ToString("HH:mm"))</td><td data-label="Mỗi lượt / tối đa">@(s==null?"—":$"{s.SlotMinutes} phút / {s.MaxPatientsPerDay} lượt")</td><td data-label="Phí khám" class="money">@(s==null?"—":Display.Money(s.Fee))</td></tr>}</tbody></table></div></section></div></div>
