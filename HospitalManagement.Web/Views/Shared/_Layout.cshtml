@{var portal=ViewData["Portal"] as bool? == true;}
<!DOCTYPE html><html lang="vi"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#F6F2E9"/>
<meta name="description" content="Chọn bác sĩ, khung giờ còn trống và nhận số thứ tự khám. Hệ thống minh họa của đồ án Lập trình Web."/>
<meta property="og:title" content="Xet Hospital — Đặt lịch khám"/><meta property="og:description" content="Chọn bác sĩ và một khung giờ còn trống. Không cần tài khoản."/><meta property="og:image" content="/img/brand/og.png"/>
<title>@ViewData["Title"] · Xet Hospital</title><link rel="icon" href="~/favicon.svg" type="image/svg+xml"/><link rel="icon" href="~/favicon.ico" sizes="32x32"/><link rel="apple-touch-icon" href="~/img/brand/favicon-180.png"/>
<link rel="preload" href="~/fonts/ibm-plex-sans-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="~/fonts/source-serif-4-vietnamese-600-normal.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-utilities.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/print.css" asp-append-version="true" media="print"/><script src="~/js/boot.js" asp-append-version="true"></script>
</head><body class="@(portal?"portal-page":"public-page")"><a class="skip-link" href="#main-content">Bỏ qua tới nội dung chính</a>
@if(portal){@RenderBody()}else{<partial name="_PublicHeader"/><main id="main-content" tabindex="-1"><partial name="_Notices"/>@RenderBody()</main><partial name="_Footer"/>}
<div id="ui-live" class="visually-hidden" role="status" aria-live="polite"></div>
<script src="~/lib/jquery/dist/jquery.min.js" defer></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js" defer></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" defer></script><script src="~/js/site.js" asp-append-version="true" defer></script><script src="~/js/booking.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts",required:false)
</body></html>
