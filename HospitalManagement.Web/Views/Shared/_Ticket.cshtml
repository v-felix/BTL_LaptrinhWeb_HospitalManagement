@model Appointment
<article class="ticket"><header class="ticket__header"><span>Phiếu khám bệnh</span><ui-status value="@Model.Status.ToString()"/></header><div class="ticket__main"><div><span class="ticket__label">Số thứ tự</span><strong class="ticket__number">@Model.SerialNo.ToString("D2")</strong></div><div><span class="ticket__day">@Model.AppointmentDate.ToString("dd/MM/yyyy")</span><time class="ticket__time">@Model.AppointmentTime.ToString("HH:mm")</time></div></div><div class="ticket__stub"><dl><dt>Bác sĩ</dt><dd>@Model.Doctor.User.FullName<br/>@Model.Doctor.Designation</dd><dt>Chuyên khoa</dt><dd>@Model.Doctor.Speciality</dd><dt>Người khám</dt><dd>@Model.PatientName<br/>@Model.PatientAge tuổi · @(Model.PatientGender=="Male"?"Nam":Model.PatientGender=="Female"?"Nữ":"Khác")</dd><dt>Mã lịch hẹn</dt><dd><span class="reference">@Model.Reference</span><button type="button" class="link-action js-only" data-copy="@Model.Reference" aria-label="Sao chép mã lịch hẹn"><ui-icon name="copy"/>Sao chép</button></dd><dt>Phí khám</dt><dd class="numeric">@Display.Money(Model.Fee)</dd></dl></div></article>
