@model News
<article class="news-row" data-category="@Model.Category"><partial name="_NewsPlate" model="Model.Category"/><div><p class="metadata">@PresentationLabels.NewsCategory(Model.Category) · <time datetime="@Model.PublishedDate.ToString("yyyy-MM-dd")">@Model.PublishedDate.ToString("dd/MM/yyyy")</time></p><h3><a asp-area="" asp-controller="Home" asp-action="Article" asp-route-id="@Model.Id">@Model.Title</a></h3><p>@Model.Excerpt</p><a class="link-action" asp-area="" asp-controller="Home" asp-action="Article" asp-route-id="@Model.Id">Đọc bài viết <ui-icon name="arrow-right"/></a></div></article>
