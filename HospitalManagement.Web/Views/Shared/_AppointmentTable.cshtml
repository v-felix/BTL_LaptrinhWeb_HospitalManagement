@model IEnumerable<Appointment>
@if(!Model.Any()){<div class="empty"><img class="plate" src="/img/plate/ledger.webp" width="200" height="200" alt="" aria-hidden="true" loading="lazy"/><h3>Chưa có lịch hẹn phù hợp</h3><p>Lịch hẹn mới sẽ được liệt kê tại đây.</p></div>}else{<div class="table-responsive"><table class="table ledger-responsive"><caption class="visually-hidden">Danh sách lịch khám</caption><thead><tr><th scope="col">Mã / Số thứ tự</th><th scope="col">Người khám</th><th scope="col">Bác sĩ</th><th scope="col">Ngày giờ</th><th scope="col">Trạng thái</th><th scope="col">Phiếu</th></tr></thead><tbody>@foreach(var a in Model){<tr><td data-label="Mã / Số"><span class="reference">@a.Reference</span><br/>Số @a.SerialNo.ToString("D2")</td><td data-label="Người khám">@a.PatientName<br/><span class="metadata">@a.PatientPhone</span></td><td data-label="Bác sĩ">@a.Doctor.User.FullName</td><td data-label="Ngày giờ">@a.AppointmentDate.ToString("dd/MM/yyyy")<br/><span class="time-code">@a.AppointmentTime.ToString("HH:mm")</span></td><td data-label="Trạng thái"><ui-status value="@a.Status.ToString()"/></td><td data-label="Phiếu"><a asp-area="" asp-controller="Appointment" asp-action="Details" asp-route-id="@a.Id" class="link-action">Chi tiết <span class="visually-hidden">@a.Reference</span><ui-icon name="arrow-right"/></a>@if(User.IsInRole(Roles.Staff)&&a.Status==BookingStatus.Pending){<form asp-area="Admin" asp-controller="Appointment" asp-action="Status" method="post"><input name="id" type="hidden" value="@a.Id"/><input name="status" type="hidden" value="Confirmed"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><button class="link-action">Xác nhận</button></form>}@if(User.IsInRole(Roles.Staff)&&a.Status is BookingStatus.Pending or BookingStatus.Confirmed){<form asp-area="Admin" asp-controller="Appointment" asp-action="Status" method="post" data-confirm="Hủy lịch khám @a.Reference?"><input name="id" type="hidden" value="@a.Id"/><input name="status" type="hidden" value="Cancelled"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><label for="staff-cancel-@a.Id" class="form-label">Lý do hủy (bắt buộc)</label><textarea id="staff-cancel-@a.Id" name="reason" class="form-control" maxlength="1000" data-counter-max="1000" required></textarea><button class="link-action link-action--danger">Hủy lịch</button></form>}</td></tr>}</tbody></table></div>}
