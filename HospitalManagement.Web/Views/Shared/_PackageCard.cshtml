@model HealthCheck
<article class="package @(Model.Popular?"package--popular":"")"><p class="package-popular">@(Model.Popular?"Gói được quan tâm":"")</p><h3>@Model.Name</h3><p class="price">@Display.Money(Model.Price)</p><ul class="feature-list">@foreach(var feature in Model.Features.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<li><ui-icon name="check"/><span>@feature</span></li>}</ul><a asp-area="" asp-controller="HealthPackage" asp-action="Book" asp-route-id="@Model.Id" class="btn @(Model.Popular?"btn-primary":"btn-outline-primary")">Đăng ký gói khám</a></article>
