@model Doctor
<article class="doctor-row"><ui-monogram id="@Model.Id" name="@Model.User.FullName" photo="@Model.User.Photo"/><div><h3><a asp-area="" asp-controller="Home" asp-action="Doctor" asp-route-id="@Model.Id">@Model.User.FullName</a></h3><p>@Model.Designation</p><p class="doctor-speciality metadata">@Model.Speciality</p></div><div class="action-row"><a asp-area="" asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@Model.Id" class="link-action">Đặt lịch <ui-icon name="arrow-right"/></a></div></article>
