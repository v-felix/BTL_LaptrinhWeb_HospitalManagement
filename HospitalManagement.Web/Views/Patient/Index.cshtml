@model PatientDashboardVM
@{Layout="_ManagementLayout";ViewData["Title"]="Lịch hẹn và hồ sơ";var upcoming=Model.Appointments.Where(x=>x.Status is BookingStatus.Pending or BookingStatus.Confirmed&&x.AppointmentDate.ToDateTime(x.AppointmentTime)>HospitalClock.Now).OrderBy(x=>x.AppointmentDate).ThenBy(x=>x.AppointmentTime).FirstOrDefault();}
<p>Hồ sơ được đặt bằng tài khoản của bạn. Lịch đặt với tư cách khách được xem qua liên kết riêng.</p>
<div class="action-row mb-4"><a href="/Appointment/Book" class="btn btn-primary">Đặt lịch mới</a><a href="/Diagnostic" class="link-action">Đặt xét nghiệm</a><a href="/HealthPackage" class="link-action">Chọn gói khám</a></div>
@if(upcoming!=null){<section class="ticket-layout mb-5"><div><h2>Lịch khám sắp tới</h2><partial name="_Ticket" model="upcoming"/><a href="/Appointment/Details/@upcoming.Id" class="link-action">Mở phiếu khám <ui-icon name="arrow-right"/></a></div><div><h2>Lưu ý trước giờ hẹn</h2><p>Kiểm tra trạng thái xác nhận và lưu mã lịch hẹn. Phí trên phiếu chưa phải xác nhận đã thu tiền.</p></div></section>}else{<div class="empty"><img class="plate" src="/img/plate/ledger.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Bạn chưa có lịch khám sắp tới.</h2><a href="/Appointment/Book" class="btn btn-primary">Đặt lịch khám</a></div>}
<nav class="record-tabs" aria-label="Loại hồ sơ"><a href="#appointments">Lịch khám (@Model.Appointments.Count)</a><a href="#diagnostics">Xét nghiệm (@Model.Diagnostics.Count)</a><a href="#packages">Gói khám (@Model.Packages.Count)</a></nav>
<section id="appointments" class="mb-5"><h2>Lịch khám và đơn thuốc</h2><partial name="_AppointmentTable" model="Model.Appointments"/></section>
<section id="diagnostics" class="mb-5"><h2>Xét nghiệm và kết quả</h2>@if(!Model.Diagnostics.Any()){<div class="empty"><img class="plate" src="/img/plate/microscope.webp" width="200" height="200" alt="" aria-hidden="true" loading="lazy"/><h3>Chưa có phiếu xét nghiệm</h3><a href="/Diagnostic" class="link-action">Xem dịch vụ xét nghiệm</a></div>}else{<div class="table-responsive"><table class="table ledger-responsive"><caption class="visually-hidden">Phiếu xét nghiệm của bạn</caption><thead><tr><th scope="col">Mã phiếu</th><th scope="col">Dịch vụ</th><th scope="col">Ngày giờ</th><th scope="col">Trạng thái</th><th scope="col">Hồ sơ</th></tr></thead><tbody>@foreach(var d in Model.Diagnostics){<tr><td data-label="Mã phiếu" class="reference">@d.Reference</td><td data-label="Dịch vụ">@d.DiagnosticService.Name</td><td data-label="Ngày giờ">@d.BookingDate.ToString("dd/MM/yyyy") · @d.BookingTime.ToString("HH:mm")</td><td data-label="Trạng thái"><ui-status value="@d.Status.ToString()"/></td><td data-label="Hồ sơ"><a href="/Diagnostic/Details/@d.Id" class="link-action">@(d.TestResults.Any()?"Xem kết quả":"Chi tiết")<span class="visually-hidden"> @d.Reference</span></a></td></tr>}</tbody></table></div>}</section>
<section id="packages"><h2>Gói khám đã đăng ký</h2>@if(!Model.Packages.Any()){<div class="empty"><img class="plate" src="/img/plate/ledger.webp" width="200" height="200" alt="" aria-hidden="true" loading="lazy"/><h3>Chưa có phiếu gói khám</h3><a href="/HealthPackage" class="link-action">Xem các gói khám</a></div>}else{<div class="table-responsive"><table class="table ledger-responsive"><caption class="visually-hidden">Gói khám của bạn</caption><thead><tr><th scope="col">Mã phiếu</th><th scope="col">Gói / Ngày hẹn</th><th scope="col">Tiền thực thu</th><th scope="col">Trạng thái</th><th scope="col">Hồ sơ</th></tr></thead><tbody>@foreach(var b in Model.Packages){<tr><td data-label="Mã phiếu" class="reference">@b.Reference</td><td data-label="Gói / Ngày">@b.HealthCheck.Name<br/>@b.BookingDate.ToString("dd/MM/yyyy")</td><td data-label="Tiền thực thu">@Display.Money(b.AmountPaid) / @Display.Money(b.TotalAmount)<progress class="payment-progress" value="@b.AmountPaid" max="@(b.TotalAmount>0?b.TotalAmount:1)" aria-label="Tiến độ thu tiền @b.Reference"></progress>@if(b.AmountPaid==0){<small>Đặt cọc chưa được tính là đã thanh toán.</small>}</td><td data-label="Trạng thái"><ui-status value="@b.Status.ToString()"/></td><td data-label="Hồ sơ"><a href="/HealthPackage/Details/@b.Id" class="link-action">Chi tiết<span class="visually-hidden"> @b.Reference</span></a></td></tr>}</tbody></table></div>}</section>
