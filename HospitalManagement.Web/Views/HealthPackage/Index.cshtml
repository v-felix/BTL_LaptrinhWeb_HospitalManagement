@model List<HealthCheck>
@{ViewData["Title"]="Gói khám sức khỏe";}
<div class="container"><header class="page-intro"><h1>Gói khám sức khỏe</h1><p>Xem các mục khám và tổng phí của từng gói.</p></header><ui-photo class="photo photo--strip" min-width="600" name="checkup-station" alt="Phòng khám sức khỏe tổng quát sáng sủa với cân và thước đo chiều cao." sizes="(min-width:1200px) 1152px, 100vw"/><div class="package-columns">@foreach(var package in Model){<partial name="_PackageCard" model="package"/>}</div><p class="notice">Đăng ký mức đặt cọc chưa được tính là thanh toán. Bạn thanh toán tại bệnh viện; nhân viên tiếp nhận ghi nhận số tiền thực thu.</p>@if(Model.Count==0){<div class="empty"><h2>Chưa có gói khám đang cung cấp</h2><a href="/Appointment/Book" class="link-action">Đặt lịch với bác sĩ</a></div>}</div>
