@model PackageBooking
@{ViewData["Title"]="Phiếu gói khám "+Model.Reference;}
<div class="form-shell"><h1>Phiếu gói khám</h1><div class="split-form">
<article class="document-sheet"><header><span class="reference">@Model.Reference</span><ui-status value="@Model.Status.ToString()"/><button type="button" class="link-action js-only" data-copy="@Model.Reference">Sao chép mã</button></header>
<dl class="detail-grid"><div><dt>Người khám</dt><dd>@Model.Patient.FullName</dd></div><div><dt>Ngày hẹn</dt><dd>@Model.BookingDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Gói khám</dt><dd>@Model.HealthCheck.Name</dd></div><div><dt>Tổng phí</dt><dd>@Display.Money(Model.TotalAmount)</dd></div><div><dt>Mức đăng ký ban đầu</dt><dd>@Model.DepositPercent% · @Display.Money(Model.TotalAmount*Model.DepositPercent/100)</dd></div><div><dt>Còn lại</dt><dd>@Display.Money(Model.TotalAmount-Model.AmountPaid)</dd></div></dl>
<div class="payment-summary"><label for="paid-progress">Đã thu @Display.Money(Model.AmountPaid) trên @Display.Money(Model.TotalAmount)</label><progress id="paid-progress" class="payment-progress" value="@Model.AmountPaid" max="@(Model.TotalAmount>0?Model.TotalAmount:1)"></progress>@if(Model.AmountPaid==0){<p>Đặt cọc chưa được tính là đã thanh toán.</p>}</div>
@if(Model.CancellationReason!=null){<p class="notice notice--warning">Lý do hủy: @Model.CancellationReason</p>}
<h2>Hạng mục của gói</h2><ul class="feature-list">@foreach(var feature in Model.HealthCheck.Features.Split((char)10,StringSplitOptions.RemoveEmptyEntries)){<li><ui-icon name="check"/><span>@feature</span></li>}</ul></article>
<aside><h2>Thanh toán tại bệnh viện</h2><p>Muốn thanh toán? Liên hệ bộ phận tiếp nhận.</p><p>Nếu cần hoàn tiền khi hủy phiếu, liên hệ bộ phận tiếp nhận.</p><a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary"><ui-icon name="download-simple"/>Tải phiếu PDF</a>
@if(Model.PatientId==User.FindFirstValue(ClaimTypes.NameIdentifier)&&Model.Status is BookingStatus.Pending or BookingStatus.Confirmed&&Model.BookingDate>HospitalClock.Today){<form asp-action="Cancel" method="post" class="mt-4" data-confirm="Hủy đăng ký gói khám này? Nếu đã thanh toán, liên hệ tiếp nhận để xử lý hoàn tiền."><input name="id" type="hidden" value="@Model.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)"/><label for="reason" class="form-label">Lý do hủy (bắt buộc)</label><textarea id="reason" name="reason" maxlength="1000" data-counter-max="1000" class="form-control mb-3" required></textarea><button class="link-action link-action--danger">Hủy đăng ký</button></form>}</aside></div></div>
