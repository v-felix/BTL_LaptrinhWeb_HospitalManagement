@model BookPackageVM
@{ViewData["Title"]="Đăng ký gói khám";var package=(HealthCheck)ViewBag.Package;}
<div class="form-shell"><h1>Đăng ký gói khám</h1><div class="split-form"><form asp-action="Book" method="post"><input asp-for="PackageId" type="hidden"/><div asp-validation-summary="All"></div><div class="mb-4"><label asp-for="BookingDate" class="form-label">Ngày khám (bắt buộc)</label><input asp-for="BookingDate" type="date" class="form-control" min="@HospitalClock.Today.AddDays(1).ToString("yyyy-MM-dd")" max="@HospitalClock.Today.AddDays(90).ToString("yyyy-MM-dd")"/><span asp-validation-for="BookingDate"></span></div><fieldset class="mb-4"><legend>Mức đăng ký thanh toán</legend><div class="segmented">@foreach(var percent in new[]{50,100}){<label><input asp-for="DepositPercent" type="radio" value="@percent"/>@percent% · @Display.Money(package.Price*percent/100)</label>}</div><span asp-validation-for="DepositPercent"></span></fieldset><div class="notice"><p>Thanh toán được nhân viên ghi nhận tại bệnh viện.</p><p>Đặt cọc khi đăng ký chưa được tính là đã thanh toán.</p></div><div class="form-actions"><button class="btn btn-primary">Đăng ký gói khám</button><a href="/HealthPackage" class="link-action">Quay lại các gói khám</a></div></form>
<aside class="ticket"><header class="ticket__header">Gói đã chọn</header><div class="ticket__stub"><h2>@package.Name</h2><p class="price">@Display.Money(package.Price)</p><ul class="feature-list">@foreach(var feature in package.Features.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<li><ui-icon name="check"/><span>@feature</span></li>}</ul></div></aside></div></div>
