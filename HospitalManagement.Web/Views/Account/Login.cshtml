@model LoginVM
@{ViewData["Title"]="Đăng nhập";}
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
<div class="auth-page"><section class="auth-page__form"><h1>Đăng nhập</h1><p>Đăng nhập để xem lịch hẹn và hồ sơ đã đặt bằng tài khoản.</p><form asp-action="Login" method="post" data-login><div asp-validation-summary="All"></div><div class="field"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password"/><span asp-validation-for="Password"></span></div><input asp-for="ReturnUrl" type="hidden"/><label class="check-label"><input asp-for="RememberMe"/>Ghi nhớ đăng nhập</label><button class="btn btn-primary">Đăng nhập</button></form><div class="action-row mt-4"><a href="/Account/Register" class="link-action">Tạo tài khoản</a><a href="/Account/ForgotPassword" class="link-action">Quên mật khẩu?</a></div>@if(HostEnvironment.EnvironmentName=="Development"){<details class="demo-accounts"><summary>Tài khoản thử của đồ án</summary><p>Chọn để điền, sau đó bấm Đăng nhập.</p><button type="button" data-demo-email="admin@example.com" data-demo-password="admin123"><span>Quản trị viên</span><span>admin@example.com</span></button><button type="button" data-demo-email="doctor@example.com" data-demo-password="doctor123"><span>Bác sĩ</span><span>doctor@example.com</span></button><button type="button" data-demo-email="staff@example.com" data-demo-password="staff123"><span>Tiếp nhận</span><span>staff@example.com</span></button><button type="button" data-demo-email="diagnostic@example.com" data-demo-password="diagnostic123"><span>Kỹ thuật viên</span><span>diagnostic@example.com</span></button><button type="button" data-demo-email="patient@example.com" data-demo-password="patient123"><span>Bệnh nhân</span><span>patient@example.com</span></button></details>}</section><div class="auth-page__photo" aria-hidden="true"><picture><source media="(min-width:900px)" srcset="/img/photo/waiting-bench-1024.webp" type="image/webp"/><img src="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27/%3E" width="1024" height="1536" alt="" loading="lazy" decoding="async"/></picture></div></div>
