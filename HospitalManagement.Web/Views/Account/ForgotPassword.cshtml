@model ForgotPasswordVM
@{ViewData["Title"]="Quên mật khẩu";}
<section class="auth-shell"><h1>Quên mật khẩu</h1><p>Nhập email đăng nhập. Nếu tài khoản tồn tại, hệ thống sẽ gửi liên kết đặt lại mật khẩu.</p><form asp-action="ForgotPassword" method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><button class="btn btn-primary">Gửi liên kết đặt lại</button></form><a href="/Account/Login" class="link-action mt-4">Về đăng nhập</a></section>
