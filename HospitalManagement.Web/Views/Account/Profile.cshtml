@model ProfileVM
@{ViewData["Title"]="Thông tin tài khoản";Layout="_ManagementLayout";}
<section class="auth-shell"><p>Thông tin này dùng khi bạn đặt lịch từ tài khoản.</p><form asp-action="Profile" method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" type="text" class="form-control" /><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" /><span asp-validation-for="Phone"></span></div><button class="btn btn-primary">Lưu thông tin</button></form><p class="mt-4">Email đăng nhập: @Model.Email</p><a href="/Account/Password" class="link-action">Đổi mật khẩu</a></section>
