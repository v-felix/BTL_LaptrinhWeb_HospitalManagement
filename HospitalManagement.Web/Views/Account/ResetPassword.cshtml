@model ResetPasswordVM
@{ViewData["Title"]="Đặt lại mật khẩu";}
<section class="auth-shell"><h1>Đặt lại mật khẩu</h1><p>Mật khẩu mới cần ít nhất 8 ký tự, có chữ thường và chữ số.</p><form asp-action="ResetPassword" method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span></div><input asp-for="Token" type="hidden"/><button class="btn btn-primary">Lưu mật khẩu mới</button></form><a href="/Account/Login" class="link-action mt-4">Về đăng nhập</a></section>
