@model PasswordVM
@{ViewData["Title"]="Đổi mật khẩu";Layout="_ManagementLayout";}
<section class="auth-shell"><p>Dùng mật khẩu mới có ít nhất 8 ký tự, chữ thường và chữ số.</p><form asp-action="Password" method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="CurrentPassword"></span></div><div class="field"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="NewPassword"></span></div><div class="field"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary">Lưu mật khẩu mới</button></form></section>
