@model RegisterVM
@{ViewData["Title"]="Tạo tài khoản bệnh nhân";}
<div class="auth-page"><section class="auth-page__form"><h1>Tạo tài khoản bệnh nhân</h1><p>Dùng tài khoản để lưu lịch hẹn, đơn thuốc và kết quả xét nghiệm.</p><form asp-action="Register" method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" type="text" class="form-control" /><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" /><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary">Đăng ký</button></form><p class="field-help">Mật khẩu tối thiểu 8 ký tự, có chữ thường và chữ số.</p><a href="/Account/Login" class="link-action">Đã có tài khoản? Đăng nhập</a></section><div class="auth-page__photo" aria-hidden="true"><picture><source media="(min-width:900px)" srcset="/img/photo/waiting-bench-1024.webp" type="image/webp"/><img src="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27/%3E" width="1024" height="1536" alt="" loading="lazy" decoding="async"/></picture></div></div>
