@model Appointment
@{ViewData["Title"]="Phiếu khám "+Model.Reference;}
<div class="container section"><h1>Phiếu khám của bạn</h1><div class="ticket-layout mt-4"><div><partial name="_Ticket" model="Model"/>@if(Model.PatientId==null){<div class="ticket-note no-print"><p>Lưu đường dẫn của trang này để xem lại phiếu.</p><p>Liên kết chứa quyền truy cập hồ sơ. Chỉ chia sẻ với người được phép.</p><button type="button" class="btn js-only" data-copy-url><ui-icon name="copy"/>Sao chép liên kết</button></div>}</div><section class="ticket-next no-print"><h2>Trước giờ khám</h2><ol><li>Lưu phiếu có mã và số thứ tự.</li><li>Theo dõi trạng thái xác nhận trên phiếu.</li><li>Đến bộ phận tiếp nhận theo ngày giờ đã chọn.</li></ol><p>Điện thoại: @Model.PatientPhone<br/>Email: @Model.PatientEmail</p>@if(!string.IsNullOrWhiteSpace(Model.Problem)){<h3>Lý do khám</h3><p class="prose">@Model.Problem</p>}@if(Model.CancellationReason!=null){<p class="notice notice--warning">Lý do hủy: @Model.CancellationReason</p>}<div class="action-row"><a asp-action="Download" asp-route-id="@Model.Id" asp-route-token="@ViewBag.Token" class="btn btn-primary"><ui-icon name="download-simple"/>Tải phiếu PDF</a><button type="button" class="btn js-only" data-print>In phiếu</button></div>
@if(ViewBag.CanCancel==true){<form asp-action="Cancel" method="post" data-confirm="Hủy lịch khám này? Khung giờ sẽ được trả lại để người khác đặt."><input name="id" type="hidden" value="@Model.Id"/><input name="token" type="hidden" value="@ViewBag.Token"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)"/><label for="reason" class="form-label">Lý do hủy (bắt buộc)</label><textarea id="reason" name="reason" maxlength="1000" data-counter-max="1000" class="form-control mb-3" required></textarea><button class="link-action link-action--danger">Hủy lịch</button></form>}</section></div>
@if(!Model.Prescriptions.Any()&&Model.Status!=BookingStatus.Completed){<div class="empty"><img class="plate" src="/img/plate/mortar.webp" width="200" height="200" alt="" aria-hidden="true"/><p>Đơn thuốc sẽ hiển thị sau khi bác sĩ hoàn tất lượt khám.</p></div>}@foreach(var prescription in Model.Prescriptions.OrderBy(x=>x.CreatedAt)){<article class="document-sheet"><header><h2>Đơn thuốc</h2><p>@Model.PatientName · @Model.Reference</p><time>@prescription.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time></header><h3>Chẩn đoán</h3><p class="prose">@prescription.Diagnosis</p><h3>Thuốc và cách dùng</h3><ol class="prescription-lines">@foreach(var line in prescription.MedicineDetails.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<li>@line</li>}</ol><h3>Lời dặn</h3><p class="prose">@prescription.Advice</p></article>}</div>
