@model BookAppointmentVM
@{ViewData["Title"]="Đặt lịch khám";var doctors=(List<Doctor>)ViewBag.Doctors;var slots=(List<AvailableSlot>)ViewBag.Slots;}
<div class="form-shell"><h1>Đặt lịch khám</h1><p>Chọn giờ còn trống. Yêu cầu mới có trạng thái Chờ xác nhận.</p><ol class="booking-steps js-only" aria-label="Tiến độ đặt lịch"><li aria-current="step">1. Bác sĩ</li><li>2. Thời gian</li><li>3. Người khám</li><li>4. Kiểm tra</li></ol><div class="split-form booking-split"><form asp-action="Book" method="post" data-booking-form><div asp-validation-summary="All"></div>
<section data-booking-stage="0"><h2>Chọn bác sĩ</h2><div class="mb-4"><label asp-for="DoctorId" class="form-label">Bác sĩ (bắt buộc)</label><select asp-for="DoctorId" data-slot-doctor class="form-select"><option value="0">Chọn bác sĩ</option>@foreach(var d in doctors){<option value="@d.Id">@d.User.FullName · @d.Speciality</option>}</select><span asp-validation-for="DoctorId"></span></div><div class="doctor-picker js-only" data-doctor-picker><div data-doctor-filters><label for="booking-doctor-search" class="form-label">Tìm tên bác sĩ</label><input id="booking-doctor-search" type="search" class="form-control"/><label for="booking-speciality" class="form-label mt-3">Chuyên khoa</label><select id="booking-speciality" class="form-select"><option value="">Tất cả chuyên khoa</option>@foreach(var speciality in doctors.Select(x=>x.Speciality).Distinct().OrderBy(x=>x)){<option>@speciality</option>}</select></div><div class="doctor-picker__rows">@foreach(var d in doctors){<button type="button" class="doctor-choice" data-doctor-id="@d.Id" data-speciality="@d.Speciality" aria-pressed="false"><ui-monogram id="@d.Id" name="@d.User.FullName" photo="@d.User.Photo"/><span><strong>@d.User.FullName</strong><span>@d.Designation</span><span>@d.Speciality</span></span></button>}</div><p data-doctor-empty hidden>Không tìm thấy bác sĩ phù hợp. Thử tên hoặc chuyên khoa khác.</p><button type="button" class="link-action" data-change-doctor hidden>Đổi bác sĩ</button></div><ui-photo name="consult-room" class="photo photo--room booking-photo" alt="Phòng khám trống với bàn gỗ và hai chiếc ghế đối diện nhau cạnh cửa sổ."/><noscript><p>Chọn bác sĩ để tải giờ trống cho ngày đang hiển thị:</p><ul>@foreach(var d in doctors){<li><a asp-action="Book" asp-route-doctorId="@d.Id">@d.User.FullName</a></li>}</ul><p>Nhập ngày và giờ theo lịch làm việc của bác sĩ. Máy chủ sẽ kiểm tra giờ trống khi gửi; nếu không hợp lệ, thông tin người khám vẫn được giữ để sửa lại.</p></noscript></section>
<section data-booking-stage="1"><h2>Chọn ngày và giờ</h2><div class="mb-4"><label asp-for="AppointmentDate" class="form-label">Ngày khám (bắt buộc)</label><input asp-for="AppointmentDate" type="date" class="form-control" data-slot-date min="@HospitalClock.Today.ToString("yyyy-MM-dd")" max="@HospitalClock.Today.AddDays(90).ToString("yyyy-MM-dd")"/><span asp-validation-for="AppointmentDate"></span></div><div class="week-picker js-only" data-week-picker aria-label="Chọn nhanh ngày khám"></div><label asp-for="AppointmentTime" class="form-label js-only"></label><select asp-for="AppointmentTime" data-slot-select disabled class="form-select js-only"><option value="">Chọn giờ khám</option>@foreach(var s in slots){<option value="@s.Time">@s.Time · @Display.Money(s.Fee)</option>}</select><noscript><label for="appointment-time-manual" class="form-label">Nhập giờ khám (bắt buộc)</label><input id="appointment-time-manual" name="AppointmentTime" type="time" value="@Model.AppointmentTime" class="form-control" required/><span asp-validation-for="AppointmentTime"></span><p class="field-help">Xem giờ làm việc trên trang chi tiết bác sĩ. Chỉ nhận giờ bắt đầu một khung khám còn trống.</p></noscript><div data-slot-grid class="slot-grid" role="group" aria-label="Khung giờ còn trống"></div><p id="slot-feedback" class="field-help" aria-live="polite">Chọn bác sĩ và ngày để xem giờ còn trống.</p></section>
<section data-booking-stage="2"><h2>Thông tin người khám</h2><div class="row g-3"><div class="col-md-6"><label asp-for="PatientName" class="form-label"></label><input asp-for="PatientName" class="form-control"/><span asp-validation-for="PatientName"></span></div><div class="col-md-6"><label asp-for="PatientPhone" class="form-label"></label><input asp-for="PatientPhone" type="tel" class="form-control"/><span asp-validation-for="PatientPhone"></span></div><div class="col-12"><label asp-for="PatientEmail" class="form-label"></label><input asp-for="PatientEmail" type="email" class="form-control"/><span asp-validation-for="PatientEmail"></span></div><div class="col-md-6"><label asp-for="PatientAge" class="form-label"></label><input asp-for="PatientAge" type="number" min="0" max="120" class="form-control"/><span asp-validation-for="PatientAge"></span></div><div class="col-md-6"><span class="form-label">Giới tính</span><div class="segmented" role="group" aria-label="Giới tính">@foreach(var item in new[]{("Male","Nam"),("Female","Nữ"),("Other","Khác")}){<label><input asp-for="PatientGender" id="gender-@item.Item1" type="radio" value="@item.Item1"/>@item.Item2</label>}</div></div><div class="col-12"><label asp-for="Problem" class="form-label"></label><textarea asp-for="Problem" class="form-control" maxlength="2000" data-counter-max="2000"></textarea><span asp-validation-for="Problem"></span></div></div></section>
<section data-booking-stage="3"><h2>Kiểm tra yêu cầu</h2><dl class="booking-review" data-booking-review></dl><p>Khung giờ sẽ được kiểm tra lại khi bạn gửi. Nếu vừa hết chỗ, thông tin đã nhập sẽ được giữ để bạn chọn giờ khác.</p>@if(User.Identity?.IsAuthenticated!=true){<p>Lưu liên kết phiếu sau khi đặt. Bạn không cần tài khoản để xem lại phiếu bằng liên kết này.</p>}</section>
<div class="form-actions"><button type="button" class="btn js-only" data-booking-back>Quay lại</button><button type="button" class="btn btn-primary js-only" data-booking-next>Tiếp tục</button><button class="btn btn-primary" data-booking-submit>Gửi yêu cầu đặt lịch</button></div></form><aside class="booking-draft"><article class="ticket ticket-draft"><header class="ticket__header">Phiếu đang điền</header><div class="ticket__main"><div><span class="ticket__label">Số thứ tự</span><strong class="ticket__number">—</strong></div><p>Số thứ tự được cấp sau khi đặt thành công.</p></div><div class="ticket__stub"><dl><dt>Bác sĩ</dt><dd data-draft-doctor>Chưa chọn</dd><dt>Ngày / giờ</dt><dd data-draft-time>Chưa chọn</dd><dt>Phí đã chọn</dt><dd data-draft-fee>Chưa chọn giờ</dd><dt>Người khám</dt><dd data-draft-patient>Chưa nhập</dd></dl></div></article><button class="btn btn-primary js-only booking-draft-next" type="button" data-draft-next>Tiếp tục</button></aside></div></div>
