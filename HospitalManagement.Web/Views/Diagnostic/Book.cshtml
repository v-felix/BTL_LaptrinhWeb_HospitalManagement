@model BookDiagnosticVM
@{ViewData["Title"]="Đăng ký xét nghiệm";var service=(DiagnosticService)ViewBag.Service;}
<div class="form-shell"><h1>Đăng ký xét nghiệm</h1><div class="split-form"><form asp-action="Book" method="post"><input asp-for="ServiceId" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3">
<div class="col-md-6"><label asp-for="BookingDate" class="form-label">Ngày xét nghiệm (bắt buộc)</label><input asp-for="BookingDate" type="date" class="form-control" min="@HospitalClock.Today.ToString("yyyy-MM-dd")" max="@HospitalClock.Today.AddDays(90).ToString("yyyy-MM-dd")"/><span asp-validation-for="BookingDate"></span></div>
<div class="col-md-6"><label asp-for="BookingTime" class="form-label"></label><input asp-for="BookingTime" type="time" min="07:00" max="17:00" class="form-control"/><span class="field-help">Tiếp nhận từ 07:00 đến 17:00.</span><span asp-validation-for="BookingTime"></span></div>
<div class="col-md-6"><label asp-for="PatientName" class="form-label"></label><input asp-for="PatientName" class="form-control"/><span asp-validation-for="PatientName"></span></div><div class="col-md-6"><label asp-for="PatientPhone" class="form-label"></label><input asp-for="PatientPhone" type="tel" class="form-control"/><span asp-validation-for="PatientPhone"></span></div>
@if(service.HomeCollectionAvailable){<div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" autocomplete="street-address"/><span asp-validation-for="Address"></span></div>}
<div class="col-12"><label asp-for="AppointmentReference" class="form-label"></label><input asp-for="AppointmentReference" class="form-control"/><span class="field-help">Nhập mã lịch khám thuộc tài khoản của bạn để liên kết phiếu.</span><span asp-validation-for="AppointmentReference"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" data-counter-max="2000"></textarea><span asp-validation-for="Notes"></span></div></div>
<p class="notice mt-4">Thanh toán được nhân viên ghi nhận tại bệnh viện. Phiếu đăng ký chưa phải xác nhận đã thu tiền.</p><div class="form-actions"><button class="btn btn-primary">Đăng ký xét nghiệm</button><a href="/Diagnostic" class="link-action">Quay lại danh mục</a></div></form>
<aside class="ticket"><header class="ticket__header">Phiếu đăng ký</header><div class="ticket__stub"><h2>@service.Name</h2><p>@service.Description</p><dl><dt>Nhóm</dt><dd>@service.Category</dd><dt>Mẫu</dt><dd>@service.SampleType</dd><dt>Thực hiện</dt><dd>@service.Duration phút</dd><dt>Trả kết quả</dt><dd>Sau @service.ReportHours giờ</dd><dt>Phí dịch vụ</dt><dd class="price">@Display.Money(service.Price)</dd></dl></div></aside></div></div>
