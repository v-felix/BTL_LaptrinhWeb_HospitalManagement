@model BookingDiagnostic
@{ViewData["Title"]="Phiếu xét nghiệm " + Model.Reference;}
<div class="form-shell"><div class="form-panel"><div class="section-head"><h1>Phiếu xét nghiệm</h1><span class="reference">@Model.Reference</span><button type="button" class="link-action js-only" data-copy="@Model.Reference">Sao chép mã</button><ui-status value="@Model.Status.ToString()"/></div><dl class="detail-grid"><div><dt>Bệnh nhân</dt><dd>@Model.PatientName</dd></div><div><dt>Điện thoại</dt><dd>@Model.PatientPhone</dd></div><div><dt>Dịch vụ</dt><dd>@Model.DiagnosticService.Name</dd></div><div><dt>Ngày giờ hẹn</dt><dd>@Model.BookingDate.ToString("dd/MM/yyyy") · @Model.BookingTime.ToString("HH:mm")</dd></div><div><dt>Phí dịch vụ</dt><dd>@Display.Money(Model.Price)</dd></div><div><dt>Thanh toán</dt><dd>@if(Model.PaymentStatus==PaymentStatus.Refunded){<span class="status Refunded"><ui-icon name="receipt"/>Đã hoàn tiền</span>}else{<ui-status value="@Model.PaymentStatus.ToString()"/>}</dd></div></dl><p class="prose">@Model.Notes</p><a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary">Tải phiếu / kết quả PDF</a>
@if(!Model.TestResults.Any()){<div class="empty"><img class="plate" src="/img/plate/microscope.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Chưa có kết quả xét nghiệm</h2><p>Kết quả được hiển thị khi kỹ thuật viên trả phiếu.</p></div>}@foreach(var r in Model.TestResults.OrderBy(x=>x.DeliveredAt)){<article class="document-sheet"><h2>Kết quả xét nghiệm</h2><p>@r.DeliveredAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><h3>Kết luận</h3><p class="prose">@r.Conclusion</p><h3>Nội dung kết quả</h3><div class="prose">@r.Content</div>@if(r.FileName!=null){<a asp-action="ResultFile" asp-route-id="@r.Id" class="btn btn-outline-primary">Tải tệp kết quả đính kèm</a>}</article>}
@if(Model.PatientId==User.FindFirstValue(ClaimTypes.NameIdentifier) && Model.Status is BookingStatus.Pending or BookingStatus.Confirmed && Model.BookingDate.ToDateTime(Model.BookingTime)>HospitalClock.Now){<form asp-action="Cancel" method="post" class="mt-4" data-confirm="Hủy phiếu xét nghiệm này?"><input name="id" type="hidden" value="@Model.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">Hủy đăng ký</button></form>}</div></div>
