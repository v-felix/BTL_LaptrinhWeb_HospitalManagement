@model List<DiagnosticService>
@{ViewData["Title"]="Dịch vụ xét nghiệm";var imaging=((string?)ViewBag.Category)?.Contains("hình ảnh",StringComparison.OrdinalIgnoreCase)==true;}
<div class="container"><header class="page-intro"><h1>Dịch vụ xét nghiệm</h1><p>Tra loại mẫu, thời gian thực hiện và phí trước khi đặt giờ tiếp nhận.</p></header><ui-photo class="photo photo--strip" min-width="600" name="@(imaging?"imaging-room":"lab-bench")" alt="@(imaging?"Phòng chẩn đoán hình ảnh trống với máy chụp và giường bệnh.":"Giá ống nghiệm trong suốt trên bàn xét nghiệm.")" sizes="(min-width:1200px) 1152px, 100vw"/>
<form method="get" class="filter-panel"><div><label for="q" class="form-label">Tên dịch vụ</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" type="search"/></div><div><label for="category" class="form-label">Nhóm dịch vụ</label><select id="category" name="category" class="form-select"><option value="">Tất cả nhóm</option>@foreach(string c in ViewBag.Categories){<option value="@c" selected="@(c==(string?)ViewBag.Category)">@c</option>}</select></div><button class="btn btn-primary">Tìm dịch vụ</button><a asp-action="Index" class="link-action">Xóa lọc</a></form>@if(User.Identity?.IsAuthenticated!=true){<p>Cần đăng nhập để đăng ký xét nghiệm. <a href="/Account/Login" class="link-action">Đăng nhập</a></p>}<p role="status">@Model.Count dịch vụ phù hợp.</p>
<div class="table-responsive"><table class="table ledger-responsive"><caption class="visually-hidden">Danh mục xét nghiệm và giá dịch vụ</caption><thead><tr><th scope="col">Dịch vụ / Nhóm</th><th scope="col">Mẫu / Thời gian</th><th scope="col" class="money">Phí</th><th scope="col">Đăng ký</th></tr></thead><tbody>@foreach(var s in Model){<tr><td data-label="Dịch vụ"><strong>@s.Name</strong><p class="metadata">@s.Category</p><details><summary class="link-action">Thông tin dịch vụ</summary><p>@s.Description</p>@if(s.HomeCollectionAvailable){<p>Có lấy mẫu tại nhà.</p>}</details></td><td data-label="Mẫu / Thời gian">@s.SampleType<br/>@s.Duration phút<br/>Kết quả sau @s.ReportHours giờ</td><td class="money" data-label="Phí">@Display.Money(s.Price)</td><td data-label="Đăng ký"><a asp-action="Book" asp-route-id="@s.Id" class="link-action">Đặt xét nghiệm <span class="visually-hidden">@s.Name</span><ui-icon name="arrow-right"/></a></td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty"><img class="plate" src="/img/plate/microscope.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Chưa tìm thấy dịch vụ</h2><a asp-action="Index" class="link-action">Xem tất cả dịch vụ</a></div>}</div>
