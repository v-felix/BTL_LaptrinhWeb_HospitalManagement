@model List<Appointment>
@{ViewData["Title"]="Tiếp nhận hôm nay";}
<div class="section-head"><div><h2>@Model.Count lịch khám hôm nay</h2><p>@Model.Count(x=>x.Status==BookingStatus.Pending) chờ xác nhận · @Model.Count(x=>x.Status==BookingStatus.Confirmed) đã xác nhận · @Model.Count(x=>x.Status==BookingStatus.Completed) hoàn tất · @Model.Count(x=>x.Status==BookingStatus.Cancelled) đã hủy</p></div><a href="/Admin/Appointment" class="btn btn-primary">Điều phối lịch hẹn</a></div><div class="filter-panel"><div><label for="today-search" class="form-label">Tên, điện thoại hoặc mã lịch hẹn</label><input id="today-search" autofocus data-quick-search data-client-filter="table tbody tr" class="form-control" type="search"/><span class="field-help">Phím / để chuyển tới ô tìm kiếm.</span></div><a href="/Admin/PackageBooking" class="link-action">Gói khám và thu phí</a></div><partial name="_AppointmentTable" model="Model"/>
