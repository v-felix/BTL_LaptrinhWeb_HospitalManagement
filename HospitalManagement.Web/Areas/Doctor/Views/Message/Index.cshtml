@model List<DoctorMessage>
@{ViewData["Title"]="Thông báo nội bộ";}
<p>@Model.Count(x=>!x.IsRead) thông báo chưa đọc.</p><ul class="message-list">@foreach(var m in Model){<li class="@(!m.IsRead?"unread":"")"><p class="metadata">@m.Admin.FullName · @m.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") · @(m.IsRead?"Đã đọc":"Chưa đọc")</p><p class="prose">@m.Message</p>@if(!m.IsRead){<form asp-action="Read" asp-route-id="@m.Id" method="post"><button class="btn">Đánh dấu đã đọc</button></form>}</li>}</ul>@if(!Model.Any()){<div class="empty"><img class="plate" src="/img/plate/ledger.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Chưa có thông báo</h2><p>Thông báo từ quản trị sẽ xuất hiện tại đây.</p></div>}
