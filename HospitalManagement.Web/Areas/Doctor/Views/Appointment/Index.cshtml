@model List<Appointment>
@{var allDates=Context.Request.Query["all"]=="1";var hasDate=ViewBag.Date is DateOnly;var shown=hasDate||allDates?Model:Model.Where(x=>x.AppointmentDate==HospitalClock.Today).OrderBy(x=>x.SerialNo).ToList();ViewData["Title"]=!hasDate&&!allDates?"Lịch khám hôm nay":"Lịch khám của tôi";var heading=allDates?"Tất cả lịch khám":hasDate?$"Lịch khám ngày {((DateOnly)ViewBag.Date).ToString("dd/MM/yyyy")}":$"Hôm nay, {HospitalClock.Today.ToString("dd/MM")}";}
<div class="section-head"><div><h2>@heading</h2><p>@shown.Count lượt khám · @shown.Count(x=>x.Status==BookingStatus.Pending) chờ xác nhận · @shown.Count(x=>x.Status==BookingStatus.Confirmed) đã xác nhận</p></div><a href="/Doctor/Appointment?date=@HospitalClock.Today.ToString("yyyy-MM-dd")" class="btn btn-primary">Xem hôm nay</a></div><div class="action-row mb-4"><a href="/Doctor/Schedule" class="link-action">Ca làm việc</a><a href="/Doctor/Message" class="link-action">Thông báo nội bộ</a></div><form method="get" class="filter-panel"><div><label for="date" class="form-label">Ngày khám</label><input id="date" name="date" type="date" class="form-control" value="@(ViewBag.Date is DateOnly date?date.ToString("yyyy-MM-dd"):"")"/></div><button class="btn btn-primary">Xem lịch</button><a asp-action="Index" asp-route-all="1" class="btn btn-light">Tất cả lịch</a></form><div class="mb-4"><label for="doctor-status" class="form-label">Lọc trạng thái trong danh sách</label><select id="doctor-status" class="form-select" data-client-filter="table tbody tr" data-filter-attribute="status"><option value="">Tất cả trạng thái</option>@foreach(var s in Enum.GetValues<BookingStatus>()){<option value="@s">@Display.Status(s)</option>}</select></div><div class="table-responsive"><table class="table"><thead><tr><th>STT / Mã</th><th>Bệnh nhân</th><th>Ngày giờ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var a in shown){<tr data-status="@a.Status"><td><strong>Số @a.SerialNo</strong><br/><small>@a.Reference</small></td><td>@a.PatientName<br/><small>@a.PatientAge tuổi · @(a.PatientGender=="Male"?"Nam":a.PatientGender=="Female"?"Nữ":"Khác") · @a.PatientPhone</small><span class="problem-preview" title="@a.Problem">@a.Problem</span></td><td>@a.AppointmentDate.ToString("dd/MM/yyyy")<br/>@a.AppointmentTime.ToString("HH:mm")</td><td><ui-status value="@a.Status.ToString()"/></td><td><div class="action-row"><a asp-area="" asp-controller="Appointment" asp-action="Details" asp-route-id="@a.Id" class="btn btn-light btn-sm">Hồ sơ</a>@if(a.Status==BookingStatus.Pending){<form asp-action="Confirm" method="post"><input name="id" type="hidden" value="@a.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><button class="btn btn-primary btn-sm">Xác nhận</button></form>}@if(a.Status==BookingStatus.Confirmed){<a asp-action="Prescribe" asp-route-id="@a.Id" class="btn btn-primary btn-sm">Khám & kê đơn</a>}</div>@if(a.Status is BookingStatus.Pending or BookingStatus.Confirmed){<form asp-action="Cancel" method="post" data-confirm="Hủy lịch khám này?" class="mt-2"><input name="id" type="hidden" value="@a.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><label for="cancel-@a.Id" class="visually-hidden">Lý do hủy</label><input id="cancel-@a.Id" name="reason" class="form-control form-control-sm mb-2" placeholder="Lý do hủy" data-counter-max="1000" maxlength="1000" required/><button class="btn btn-outline-danger btn-sm">Hủy lịch</button></form>}</td></tr>}</tbody></table></div>@if(!shown.Any()){<p class="empty mt-3">Chưa có bệnh nhân hẹn khám.</p>}
