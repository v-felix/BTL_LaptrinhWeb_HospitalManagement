@model List<Schedule>
@{ViewData["Title"]="Lịch làm việc hàng tuần";}
<div class="action-row mb-4"><a asp-action="Edit" class="btn btn-primary">Thêm ca làm việc</a><a href="/Doctor/Appointment" class="link-action">Kiểm tra lịch đã đặt</a></div><p>Mỗi thứ có tối đa một ca. Kiểm tra lịch hẹn hiện có trước khi đổi hoặc xóa ca.</p>
<div class="table-responsive"><table class="table"><caption class="visually-hidden">Ca khám của tôi theo thứ trong tuần</caption><thead><tr><th>Ngày</th><th>Giờ khám</th><th>Phút / lượt</th><th>Tối đa</th><th class="money">Phí khám</th><th>Thao tác</th></tr></thead><tbody>@foreach(var day in new[]{1,2,3,4,5,6,0}){var s=Model.FirstOrDefault(x=>x.DayOfWeek==day);<tr><th scope="row">@Display.Day(day)</th><td>@(s==null?"Nghỉ":s.StartTime.ToString("HH:mm")+" – "+s.EndTime.ToString("HH:mm"))</td><td>@(s?.SlotMinutes.ToString()??"—")</td><td>@(s?.MaxPatientsPerDay.ToString()??"—")</td><td class="money">@(s==null?"—":Display.Money(s.Fee))</td><td>@if(s!=null){<div class="action-row"><a asp-action="Edit" asp-route-id="@s.Id" class="link-action">Sửa @Display.Day(day)</a><form asp-action="Delete" asp-route-id="@s.Id" method="post" data-confirm="Xóa ca @Display.Day(day)? Các lịch đã đặt vẫn được giữ; cần kiểm tra và thông báo người khám."><button class="link-action link-action--danger">Xóa ca</button></form></div>}else{<a asp-action="Edit" class="link-action">Thêm ca</a>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty"><img class="plate" src="/img/plate/watch.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Chưa có lịch làm việc</h2><p>Thêm ca để người khám chọn được khung giờ.</p></div>}
