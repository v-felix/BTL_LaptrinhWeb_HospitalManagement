@model List<News>
@{ViewData["Title"]="Tin tức bệnh viện";}
<div class="action-row mb-4"><a asp-action="Create" class="btn btn-primary">Thêm mới</a><span class="small-muted">@Model.Count mục</span></div><div class="mb-4"><label for="catalog-search" class="form-label">Tìm trong danh mục đang hiển thị</label><input id="catalog-search" type="search" data-client-filter="table tbody tr" class="form-control"/><noscript><p>Dùng chức năng tìm của trình duyệt để tìm trong danh mục.</p></noscript></div><div class="table-responsive"><table class="table"><thead><tr><th>Tiêu đề</th><th>Chuyên mục</th><th>Ngày đăng</th><th>Công khai</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Title</td><td>@item.Category</td><td>@item.PublishedDate.ToString("dd/MM/yyyy")</td><td>@(item.IsPublished?"Có":"Không")</td><td><div class="action-row"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm">Sửa</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Bạn muốn xóa mục này?"><button class="btn btn-outline-danger btn-sm">Xóa</button></form></div></td></tr>}</tbody></table></div>
