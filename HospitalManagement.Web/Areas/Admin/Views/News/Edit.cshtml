@model News
@{ViewData["Title"]=Model.Id==0?"Thêm mới · Tin tức bệnh viện":"Chỉnh sửa · Tin tức bệnh viện";}
<div class="split-form catalog-editor" data-catalog-editor><form data-news-preview asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" data-counter-max="250" maxlength="250" type="text" class="form-control" /><span asp-validation-for="Title"></span></div><div class="col-md-6"><label asp-for="Category" class="form-label"></label><input asp-for="Category" type="text" class="form-control" /><span asp-validation-for="Category"></span></div><div class="col-md-6"><label asp-for="PublishedDate" class="form-label"></label><input asp-for="PublishedDate" type="date" class="form-control" /><span asp-validation-for="PublishedDate"></span></div><div class="col-12"><label asp-for="Excerpt" class="form-label"></label><textarea asp-for="Excerpt" rows="4" class="form-control"></textarea><span asp-validation-for="Excerpt"></span></div><div class="col-12"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" rows="12" class="form-control"></textarea><span asp-validation-for="Content"></span></div><div class="col-12"><div class="check-label"><input asp-for="IsPublished" class="form-check-input me-2"/><label asp-for="IsPublished"></label></div></div></div><div class="form-actions"><button class="btn btn-primary">Lưu dữ liệu</button><a asp-action="Index" class="btn btn-light">Quay lại</a></div></form><aside class="catalog-live-preview" aria-label="Xem trước bài viết"><h2>Xem trước bài viết</h2><p class="field-help">Nội dung đang nhập, chưa lưu.</p><article class="catalog-preview-article"><h3 data-preview-title></h3><p data-preview-excerpt></p><div class="prose" data-preview-content></div></article></aside></div>