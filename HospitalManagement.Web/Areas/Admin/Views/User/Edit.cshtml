@model UserEditVM
@{ViewData["Title"]=Model.Id==null?"Thêm tài khoản":"Cập nhật tài khoản";}
<div class="form-panel u-form-wide"><form asp-action="@(Model.Id==null?"Create":"Edit")" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" type="text" class="form-control" /><span asp-validation-for="FullName"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" /><span asp-validation-for="Phone"></span></div><div class="col-md-6"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select">@foreach(var role in Roles.All){<option value="@role">@Display.Role(role)</option>}</select></div><div class="col-md-6"><label asp-for="Password" class="form-label">@(Model.Id==null?"Mật khẩu (bắt buộc)":"Mật khẩu mới (để trống nếu không đổi)")</label><input asp-for="Password" required="@(Model.Id==null)" type="password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password"></span></div><div class="col-12"><p class="notice">Tài khoản đã có hồ sơ nghiệp vụ sẽ được khóa thay vì xóa. Bỏ chọn cho phép đăng nhập để khóa tài khoản; người này sẽ không đăng nhập được.</p><div class="check-label"><input asp-for="IsActive" class="form-check-input me-2"/><label asp-for="IsActive"></label></div></div><div class="col-12"><hr/><h2 class="h5">Hồ sơ chuyên môn</h2><p class="small-muted">Bác sĩ cần chức danh và chuyên khoa. Nhân viên có thể bổ sung phòng ban.</p></div><div class="col-md-6"><label asp-for="Designation" class="form-label"></label><input asp-for="Designation" type="text" class="form-control" /><span asp-validation-for="Designation"></span></div><div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" type="text" class="form-control" /><span asp-validation-for="Department"></span></div><div class="col-12"><label asp-for="About" class="form-label"></label><textarea asp-for="About" rows="4" class="form-control"></textarea><span asp-validation-for="About"></span></div></div><div class="form-actions"><button class="btn btn-primary">Lưu tài khoản</button><a asp-action="Index" class="btn btn-light">Quay lại</a></div></form></div>
