@model List<ApplicationUser>
@{ViewData["Title"]="Tài khoản & nhân sự";var roles=(Dictionary<string,string>)ViewBag.Roles;}
<div class="action-row mb-3"><a data-edit-modal asp-action="Create" asp-route-role="@ViewBag.Role" class="btn btn-primary">Thêm tài khoản</a></div><form method="get" class="filter-panel"><div><label for="q" class="form-label">Tên / Email</label><input id="q" name="q" data-quick-search value="@ViewBag.Q" class="form-control"/></div><div><label for="role" class="form-label">Vai trò</label><select id="role" name="role" class="form-select"><option value="">Tất cả</option>@foreach(var r in Roles.All){<option value="@r" selected="@(r==(string?)ViewBag.Role)">@Display.Role(r)</option>}</select></div><button class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-light">Xóa lọc</a></form><p class="small-muted">@Model.Count tài khoản</p><div class="table-responsive"><table class="table"><thead><tr><th>Nhân sự / Bệnh nhân</th><th>Vai trò</th><th>Chuyên khoa / Phòng ban</th><th>Hoạt động</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in Model){<tr><td><strong>@u.FullName</strong><br/><span class="small-muted">@u.Email</span></td><td>@Display.Role(roles.GetValueOrDefault(u.Id,Roles.Patient))</td><td>@(u.DoctorProfile?.Speciality ?? u.StaffProfile?.Department)<br/><small>@(u.DoctorProfile?.Designation ?? u.StaffProfile?.Designation)</small></td><td>@(u.IsActive?"Đang hoạt động":"Đã khóa")</td><td><div class="action-row"><a data-edit-modal asp-action="Edit" asp-route-id="@u.Id" class="btn btn-light btn-sm">Sửa</a>@if(u.DoctorProfile!=null){<a asp-controller="Schedule" asp-action="Index" asp-route-doctorId="@u.DoctorProfile.Id" class="btn btn-light btn-sm">Ca khám</a>}@if(u.Id!=User.FindFirstValue(ClaimTypes.NameIdentifier)){<form asp-action="Delete" asp-route-id="@u.Id" method="post" data-confirm="Xóa tài khoản này? Tài khoản có hồ sơ nghiệp vụ cần khóa thay vì xóa."><button class="btn btn-outline-danger btn-sm">Xóa</button></form>}</div></td></tr>}</tbody></table></div>
