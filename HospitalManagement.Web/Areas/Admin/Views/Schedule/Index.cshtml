@model List<Schedule>
@{ViewData["Title"]="Lịch làm việc hàng tuần";var doctors=(List<Doctor>)ViewBag.Doctors;int? selectedDoctor=ViewBag.DoctorId;var shown=selectedDoctor.HasValue?doctors.Where(x=>x.Id==selectedDoctor):doctors.Where(x=>Model.Any(s=>s.DoctorId==x.Id));}
<form method="get" class="filter-panel"><div><label for="doctorId" class="form-label">Bác sĩ</label><select id="doctorId" name="doctorId" class="form-select"><option value="">Tất cả bác sĩ có ca</option>@foreach(var d in doctors){<option value="@d.Id" selected="@(d.Id==selectedDoctor)">@d.User.FullName</option>}</select></div><button class="btn btn-primary">Xem lịch</button><a asp-action="Edit" asp-route-doctorId="@selectedDoctor" class="link-action">Thêm ca làm việc</a></form>
<p class="notice notice--warning">Thay đổi ca làm việc có thể ảnh hưởng tới các lịch đã đặt. Kiểm tra lịch hẹn của bác sĩ trước khi lưu.</p>
@foreach(var d in shown){<section class="mb-5"><div class="section-head"><h2>@d.User.FullName</h2><a href="/Admin/Appointment?doctorId=@d.Id" class="link-action">Kiểm tra lịch đã đặt</a></div><div class="table-responsive"><table class="table"><caption class="visually-hidden">Lịch làm việc của @d.User.FullName</caption><thead><tr><th>Thứ</th><th>Ca khám</th><th>Phút / lượt</th><th>Tối đa</th><th class="money">Phí khám</th><th>Lưu từng ca</th></tr></thead><tbody>@foreach(var day in new[]{1,2,3,4,5,6,0}){var s=Model.FirstOrDefault(x=>x.DoctorId==d.Id&&x.DayOfWeek==day);<tr><th scope="row">@Display.Day(day)</th><td>@(s==null?"Nghỉ":s.StartTime.ToString("HH:mm")+" – "+s.EndTime.ToString("HH:mm"))</td><td>@(s?.SlotMinutes.ToString()??"—")</td><td>@(s?.MaxPatientsPerDay.ToString()??"—")</td><td class="money">@(s==null?"—":Display.Money(s.Fee))</td><td>@if(s!=null){<div class="action-row"><a asp-action="Edit" asp-route-id="@s.Id" class="link-action">Sửa ca</a><form asp-action="Delete" asp-route-id="@s.Id" method="post" data-confirm="Xóa ca @Display.Day(day) của @d.User.FullName? Các lịch đã đặt vẫn được giữ."><button class="link-action link-action--danger">Xóa ca</button></form></div>}else{<a asp-action="Edit" asp-route-doctorId="@d.Id" class="link-action">Thêm ca</a>}</td></tr>}</tbody></table></div></section>}
@if(!shown.Any()){<div class="empty"><img class="plate" src="/img/plate/watch.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Chưa có ca làm việc</h2><a asp-action="Edit" class="link-action">Thêm ca</a></div>}
<section class="u-form-wide"><h2>Gửi thông báo cho bác sĩ</h2><form asp-action="Notify" method="post"><div class="mb-4"><label for="notifyDoctor" class="form-label">Bác sĩ nhận (bắt buộc)</label><select id="notifyDoctor" name="doctorId" class="form-select">@foreach(var d in doctors){<option value="@d.Id" selected="@(d.Id==selectedDoctor)">@d.User.FullName</option>}</select></div><label for="message" class="form-label">Nội dung (bắt buộc)</label><textarea id="message" name="message" maxlength="2000" data-counter-max="2000" class="form-control" required></textarea><button class="btn btn-primary mt-3">Gửi thông báo</button></form></section>
