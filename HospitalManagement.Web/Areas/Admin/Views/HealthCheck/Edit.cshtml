@model HealthCheck
@{ViewData["Title"]=Model.Id==0?"Thêm mới · Gói khám sức khỏe":"Chỉnh sửa · Gói khám sức khỏe";}
<div class="split-form catalog-editor" data-catalog-editor><form data-package-preview asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" type="text" class="form-control" /><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" class="form-control" step="1" min="0" data-money/><span asp-validation-for="Price"></span></div><div class="col-12"><label asp-for="Features" class="form-label"></label><textarea asp-for="Features" data-repeat-lines rows="4" class="form-control"></textarea><span asp-validation-for="Features"></span></div><div class="col-12"><div class="check-label"><input asp-for="Popular" class="form-check-input me-2"/><label asp-for="Popular"></label></div></div><div class="col-12"><div class="check-label"><input asp-for="IsActive" class="form-check-input me-2"/><label asp-for="IsActive"></label></div></div></div><div class="form-actions"><button class="btn btn-primary">Lưu dữ liệu</button><a asp-action="Index" class="btn btn-light">Quay lại</a></div></form><aside class="catalog-live-preview" aria-label="Xem trước gói khám"><h2>Xem trước gói khám</h2><p class="field-help">Nội dung đang nhập, chưa lưu.</p><article class="package" data-preview-package><p class="package-popular" data-preview-popular></p><h3 data-preview-name>@Model.Name</h3><p class="price" data-preview-price>@Display.Money(Model.Price)</p><ul class="feature-list" data-preview-features>@foreach(var feature in Model.Features.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<li><ui-icon name="check"/><span>@feature</span></li>}</ul><button type="button" class="btn" disabled>Đăng ký gói khám</button></article></aside></div>
