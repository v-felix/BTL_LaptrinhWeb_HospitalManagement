@model DashboardVM
@{ViewData["Title"]="Tổng quan bệnh viện";}
<p>Số liệu hiện có trong hệ thống, cập nhật khi tải trang.</p><dl class="ledger-totals"><div class="ledger-total"><dt>Bác sĩ đang hoạt động</dt><dd><strong>@Model.Doctors</strong></dd></div><div class="ledger-total"><dt>Tài khoản bệnh nhân</dt><dd><strong>@Model.Patients</strong></dd></div><div class="ledger-total"><dt>Lịch khám hôm nay</dt><dd><strong>@Model.Today</strong></dd></div><div class="ledger-total"><dt>Chờ xác nhận</dt><dd><strong>@Model.Pending</strong></dd></div></dl>
<div class="section-head"><div><h2>Tiền gói khám đã ghi nhận</h2><p class="price">@Display.Money(Model.RecordedPackagePayments)</p></div><a href="/Admin/PackageBooking" class="link-action">Xem phiếu và thu phí <ui-icon name="arrow-right"/></a></div><div class="action-row mb-5"><a href="/Admin/User/Create?role=Doctor" class="btn btn-primary">Thêm bác sĩ</a><a href="/Admin/Appointment" class="link-action">Quản lý lịch hẹn</a><a href="/Admin/Schedule" class="link-action">Lịch làm việc</a></div><h2>Lịch hẹn mới nhất</h2><partial name="_AppointmentTable" model="Model.Appointments"/>
