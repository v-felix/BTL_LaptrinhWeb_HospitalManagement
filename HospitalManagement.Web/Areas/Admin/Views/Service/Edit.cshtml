@model DiagnosticService
@{ViewData["Title"]=Model.Id==0?"Thêm mới · Dịch vụ xét nghiệm":"Chỉnh sửa · Dịch vụ xét nghiệm";}
<div class="form-panel u-form-wide"><form asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" type="text" class="form-control" /><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="Category" class="form-label"></label><input asp-for="Category" type="text" class="form-control" /><span asp-validation-for="Category"></span></div><div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" class="form-control" step="1" min="0" data-money/><span asp-validation-for="Price"></span></div><div class="col-md-6"><label asp-for="SampleType" class="form-label"></label><input asp-for="SampleType" type="text" class="form-control" /><span asp-validation-for="SampleType"></span></div><div class="col-md-6"><label asp-for="Duration" class="form-label">Thời gian thực hiện (phút)</label><input asp-for="Duration" type="number" class="form-control" /><span asp-validation-for="Duration"></span></div><div class="col-md-6"><label asp-for="ReportHours" class="form-label">Trả kết quả sau (giờ)</label><input asp-for="ReportHours" type="number" class="form-control" /><span asp-validation-for="ReportHours"></span></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea><span asp-validation-for="Description"></span></div><div class="col-12"><div class="check-label"><input asp-for="HomeCollectionAvailable" class="form-check-input me-2"/><label asp-for="HomeCollectionAvailable"></label></div></div><div class="col-12"><div class="check-label"><input asp-for="IsActive" class="form-check-input me-2"/><label asp-for="IsActive"></label></div></div></div><div class="form-actions"><button class="btn btn-primary">Lưu dữ liệu</button><a asp-action="Index" class="btn btn-light">Quay lại</a></div></form></div>
