@model List<PackageBooking>
@{ViewData["Title"]="Phiếu gói khám và thu phí";}
<p>Ghi nhận tổng tiền thực thu của từng phiếu. Mức đăng ký đặt cọc không tự làm tăng tiền đã thu.</p><div class="mb-4"><label for="package-search" class="form-label">Tìm mã phiếu hoặc tên người khám</label><input id="package-search" type="search" data-client-filter="table tbody tr" data-quick-search class="form-control"/></div>
<div class="table-responsive"><table class="table"><caption class="visually-hidden">Đăng ký gói khám và tiền thực thu</caption><thead><tr><th>Phiếu / Người khám</th><th>Gói / Ngày hẹn</th><th>Tổng phí / Đã thu</th><th>Trạng thái</th><th>Ghi nhận</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><a href="/HealthPackage/Details/@b.Id" class="reference">@b.Reference</a><br/>@b.Patient.FullName</td><td>@b.HealthCheck.Name<br/>@b.BookingDate.ToString("dd/MM/yyyy")<br/><small>Mức đăng ký: @b.DepositPercent%</small></td><td>@Display.Money(b.TotalAmount)<p>Đã thu @Display.Money(b.AmountPaid)</p><progress class="payment-progress" max="@(b.TotalAmount>0?b.TotalAmount:1)" value="@b.AmountPaid" aria-label="Đã thu @Display.Money(b.AmountPaid) trên @Display.Money(b.TotalAmount)"></progress>@if(b.AmountPaid==0){<small>Đặt cọc chưa được tính là đã thanh toán.</small>}</td><td><ui-status value="@b.Status.ToString()"/>@if(b.CancellationReason!=null){<p>@b.CancellationReason</p>}</td><td>@if(b.Status is BookingStatus.Pending or BookingStatus.Confirmed){<form asp-action="Update" method="post" data-payment-reference="@b.Reference" data-confirm="Ghi nhận thu tiền"><input name="id" type="hidden" value="@b.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(b.RowVersion)"/><label for="paid-@b.Id" class="form-label">Tổng đã thu (VND, bắt buộc)</label><input id="paid-@b.Id" name="amountPaid" data-money type="number" min="0" max="@b.TotalAmount" step="1" value="@b.AmountPaid" class="form-control" required/><p class="field-help">Đã ghi nhận: @Display.Money(b.AmountPaid). Tổng phí: @Display.Money(b.TotalAmount).</p><label for="status-@b.Id" class="form-label">Trạng thái</label><select id="status-@b.Id" name="status" class="form-select">@foreach(var s in Enum.GetValues<BookingStatus>().Where(s=>s==b.Status||AppointmentService.CanTransition(b.Status,s))){<option value="@s" selected="@(s==b.Status)">@Display.Status(s)</option>}</select><label for="reason-@b.Id" class="form-label">Lý do nếu hủy</label><textarea id="reason-@b.Id" name="reason" maxlength="1000" data-counter-max="1000" class="form-control"></textarea><p>Nếu cần hoàn tiền, liên hệ bộ phận tiếp nhận.</p><p class="field-help">Số tiền nhập là tổng đã thu của phiếu. Kiểm tra số tiền và mã phiếu trước khi lưu.</p><button class="btn btn-primary">Lưu cập nhật</button></form>}else{<span>Phiếu đã kết thúc</span>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty"><img class="plate" src="/img/plate/ledger.webp" width="200" height="200" alt="" aria-hidden="true"/><h2>Chưa có đăng ký gói khám</h2></div>}
