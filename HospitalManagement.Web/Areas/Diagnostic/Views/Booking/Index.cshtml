@model List<BookingDiagnostic>
@{ViewData["Title"]="Tiếp nhận & trả kết quả";}
<form method="get" class="filter-panel"><div><label for="date" class="form-label">Ngày hẹn</label><input id="date" name="date" type="date" class="form-control" value="@(ViewBag.Date is DateOnly date?date.ToString("yyyy-MM-dd"):"")"/></div><div><label for="status" class="form-label">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả</option>@foreach(var s in Enum.GetValues<BookingStatus>()){<option value="@s" selected="@(s==(BookingStatus?)ViewBag.Status)">@Display.Status(s)</option>}</select></div><button class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-light">Xóa lọc</a></form><div class="table-responsive"><table class="table"><thead><tr><th>Bệnh nhân / Mã phiếu</th><th>Dịch vụ / Mẫu</th><th>Ngày giờ</th><th>Trạng thái / Thanh toán</th><th>Tiếp nhận</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><strong>@b.PatientName</strong><br/><small>@b.Reference · @b.PatientPhone</small></td><td>@b.DiagnosticService.Name<br/><small>Mẫu: @(b.DiagnosticService.SampleType??"Chưa ghi")</small><br/>@Display.Money(b.Price)</td><td>@b.BookingDate.ToString("dd/MM/yyyy")<br/>@b.BookingTime.ToString("HH:mm")</td><td><ui-status value="@b.Status.ToString()"/><br/><ui-status value="@b.PaymentStatus.ToString()"/></td><td><div class="action-row mb-2"><a asp-area="" asp-controller="Diagnostic" asp-action="Details" asp-route-id="@b.Id" class="btn btn-light btn-sm">Hồ sơ / kết quả</a>@if(b.Status==BookingStatus.Confirmed){<a asp-action="Result" asp-route-id="@b.Id" class="btn btn-primary btn-sm">Trả kết quả</a>}else if(b.Status==BookingStatus.Pending){<span class="field-help">Xác nhận tiếp nhận phiếu trước khi trả kết quả.</span>}else if(b.Status==BookingStatus.Cancelled){<span class="field-help">Phiếu đã hủy, không thể trả kết quả.</span>}</div>@if(b.Status is BookingStatus.Pending or BookingStatus.Confirmed){<form asp-action="Status" method="post"><input name="id" type="hidden" value="@b.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(b.RowVersion)"/><select name="status" class="form-select form-select-sm mb-2" aria-label="Trạng thái phiếu">@foreach(var s in Enum.GetValues<BookingStatus>().Where(s=>s!=BookingStatus.Completed && (s==b.Status || AppointmentService.CanTransition(b.Status,s)))){<option value="@s" selected="@(s==b.Status)">@Display.Status(s)</option>}</select><select name="paymentStatus" class="form-select form-select-sm" aria-label="Thanh toán"><option value="Unpaid" selected="@(b.PaymentStatus==PaymentStatus.Unpaid)">Chưa thu tiền</option><option value="Paid" selected="@(b.PaymentStatus==PaymentStatus.Paid)">Đã thu tiền</option><option value="Refunded" selected="@(b.PaymentStatus==PaymentStatus.Refunded)">Đã hoàn tiền</option></select><button class="btn btn-outline-primary btn-sm mt-2">Lưu tiếp nhận</button></form>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="empty mt-3">Chưa có phiếu phù hợp.</p>}
