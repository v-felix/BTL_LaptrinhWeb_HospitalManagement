@model ResultVM
@{ViewData["Title"]="Nhập kết quả xét nghiệm";var b=(BookingDiagnostic)ViewBag.Booking;}
<div class="split-form clinical-form technician-form">
    <form asp-action="Result" method="post" enctype="multipart/form-data">
        <input asp-for="BookingId" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All"></div>
        <div class="mb-4"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" rows="12" class="form-control"></textarea><span asp-validation-for="Content"></span></div>
        <div class="mb-4"><label asp-for="Conclusion" class="form-label"></label><textarea asp-for="Conclusion" rows="4" class="form-control"></textarea><span asp-validation-for="Conclusion"></span></div>
        <div class="upload-zone"><label asp-for="File" class="form-label"></label><input asp-for="File" type="file" class="form-control" accept="application/pdf,.pdf"/><p class="field-help">Chọn tệp PDF không quá 5 MB. Bạn có thể mở bản xem trước để kiểm tra trước khi trả kết quả.</p><span asp-validation-for="File"></span></div>
        <div class="form-actions"><button class="btn btn-primary">Lưu & trả kết quả</button><a asp-action="Index" class="link-action">Quay lại danh sách</a></div>
    </form>
    <aside class="clinical-context" aria-label="Thông tin phiếu xét nghiệm"><h2>@b.PatientName</h2><p class="reference">@b.Reference</p><dl class="context-details"><dt>Dịch vụ</dt><dd>@b.DiagnosticService.Name</dd><dt>Mẫu</dt><dd>@(b.DiagnosticService.SampleType??"Chưa ghi loại mẫu")</dd><dt>Ngày / giờ</dt><dd>@b.BookingDate.ToString("dd/MM/yyyy") · @b.BookingTime.ToString("HH:mm")</dd><dt>Điện thoại</dt><dd>@b.PatientPhone</dd></dl><div class="action-row"><ui-status value="@b.Status.ToString()"/><ui-status value="@b.PaymentStatus.ToString()"/></div><p class="field-help mt-4">Kiểm tra đúng người khám, mã phiếu và tệp đính kèm trước khi lưu.</p></aside>
</div>
